{
  "name": "datavizclaus",
  "image": "venustiano/fdvcw:27-12-25",
  "workspaceFolder": "/home/jovyan/work",
  "workspaceMount": "source=${localWorkspaceFolder},target=/home/jovyan/work,type=bind,consistency=cached",
  "remoteUser": "jovyan",
  "overrideCommand": false,
  "postStartCommand": "sudo /home/jovyan/work/. devcontainer/start-services.sh",
  "forwardPorts": [8787, 8888],
  "portsAttributes": {
    "8787":  {
      "label": "RStudio Server",
      "onAutoForward": "notify"
    },
    "8888": {
      "label": "Jupyter Lab",
      "onAutoForward": "notify"
    }
  }
}
